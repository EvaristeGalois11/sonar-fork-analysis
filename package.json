{
  "name": "sonar-fork-analysis",
  "description": "Sonar scan external forks of your project",
  "version": "0.0.0",
  "author": "Claudio Nave",
  "type": "module",
  "private": true,
  "homepage": "https://github.com/EvaristeGalois11/sonar-fork-analysis",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EvaristeGalois11/sonar-fork-analysis.git"
  },
  "bugs": {
    "url": "https://github.com/EvaristeGalois11/sonar-fork-analysis/issues"
  },
  "keywords": [
    "actions",
    "sonar"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "bundle": "npm run format:write && npm run package",
    "format:write": "npx prettier --write .",
    "format:check": "npx prettier --check .",
    "lint": "npx eslint --max-warnings 0 .",
    "lint:deps": "npx knip && npx lockfile-lint",
    "lint:workflows": "node scripts/lint-workflows.ts",
    "local": "npm run package && node --env-file=.env dist/index.js",
    "package": "npx rimraf ./dist && npx rollup --config rollup.config.ts --configPlugin @rollup/plugin-typescript",
    "package:watch": "npm run package -- --watch",
    "scanner:check": "node scripts/scanner-version.ts",
    "scanner:update": "node scripts/scanner-version.ts --update",
    "test": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js",
    "test:scanner": "SCANNER_CHECKS=1 node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js __tests__/real-scanner.test.ts --coverage=false",
    "typecheck": "npx tsc --noEmit --project . && npx tsc --project __tests__ && npx tsc --project scripts",
    "all": "npm run format:write && npm run lint && npm run lint:deps && npm run lint:workflows && npm run typecheck && npm run test && npm run package"
  },
  "license": "MIT",
  "dependencies": {
    "@actions/artifact": "^6.2.1",
    "@actions/core": "^3.0.0",
    "@actions/exec": "^3.0.0",
    "@actions/tool-cache": "^4.0.0"
  },
  "devDependencies": {
    "@actions/workflow-parser": "^0.3.61",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.2.0",
    "@octokit/openapi-webhooks-types": "^12.1.0",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jest": "^29.15.0",
    "eslint-plugin-n": "^18.4.1",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-regexp": "^3.3.1",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "jest": "^30.2.0",
    "knip": "^6.39.0",
    "lockfile-lint": "^5.0.1",
    "prettier": "^3.8.1",
    "rollup": "^4.57.1",
    "rollup-plugin-license": "^3.7.1",
    "ts-jest": "^29.4.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "*"
  }
}
