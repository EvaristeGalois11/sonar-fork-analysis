# Copy to .env (which is git-ignored) and run: npm run local
# Inputs keep their hyphens: INPUT_WORKING-DIRECTORY, not INPUT_WORKING_DIRECTORY.

ACTIONS_STEP_DEBUG=false

# Decides the auto mode: workflow_run analyses an artifact, anything else builds.
GITHUB_EVENT_NAME=push

# direct needs INPUT_SONAR-TOKEN; prepare and analyze are not implemented yet.
INPUT_MODE=direct
INPUT_WORKING-DIRECTORY=fixtures/maven
INPUT_BUILD-TOOL=auto
INPUT_BUILD-GOALS=
INPUT_BUILD-ARGUMENTS=
INPUT_PROJECT-KEY=local-maven
INPUT_SONAR-ORGANIZATION=
INPUT_SONAR-HOST-URL=http://localhost:9000
INPUT_SONAR-TOKEN=
